---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';

const products = (await getCollection('products'))
  .map((entry) => entry.data)
  .filter((product) => product.featured)
  .slice(0, 3);

const routes = [
  { href: '/products/', label: 'Products', detail: 'Residential, C&I, PV hybrid, and containerized storage' },
  { href: '/solutions/', label: 'Solutions', detail: 'Match a battery platform to your application' },
  { href: '/projects/', label: 'Projects', detail: 'Reference deployments across four regions' },
  { href: '/technology/', label: 'Technology', detail: 'Chemistry, BMS, thermal management, and safety' },
  { href: '/blog/', label: 'Blog', detail: 'Sizing guides and technical explainers' },
  { href: '/contact/', label: 'Contact', detail: 'Send a project inquiry for quotation' },
];
---

<BaseLayout
  title="Page not found | Ruibit Power"
  description="The page you requested could not be found. Browse Ruibit Power products, solutions, and reference projects, or send a project inquiry."
  noindex={true}
>
  <section class="page-hero">
    <p class="eyebrow">Error 404</p>
    <h1>This page is not here.</h1>
    <p>The link may be outdated or mistyped. Use the routes below, or send your project requirements and our team will point you to the right system.</p>
    <div class="hero-actions">
      <a class="button primary" href="/contact/">Send an inquiry</a>
      <a class="button secondary" href="/products/">Browse products</a>
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <div>
        <p class="eyebrow">Popular routes</p>
        <h2>Where most visitors go next</h2>
      </div>
    </div>
    <div class="trust-grid trust-grid-3">
      {routes.map((route) => (
        <article>
          <h3><a href={route.href}>{route.label}</a></h3>
          <p>{route.detail}</p>
        </article>
      ))}
    </div>
  </section>

  {products.length > 0 && (
    <section class="section section-soft">
      <div class="section-header">
        <div>
          <p class="eyebrow">Core lineup</p>
          <h2>Representative products</h2>
        </div>
        <a class="text-link" href="/products/">View all products</a>
      </div>
      <div class="product-grid">
        {products.map((product) => <ProductCard product={product} />)}
      </div>
    </section>
  )}
</BaseLayout>

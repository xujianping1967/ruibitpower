---
import imageSizeData from '../../data/image-sizes.json';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pagination from '../../components/Pagination.astro';

export async function getStaticPaths({ paginate }: any) {
  const posts = (await getCollection('blog'))
    .map((entry) => ({ ...entry.data, slug: entry.id }))
    .sort((a, b) => b.publishDate.getTime() - a.publishDate.getTime());
  /* paginate() renders /blog for page one and /blog/2, /blog/3 … after it, so
     the address people already link to keeps working and the archive stays a
     set of static files — no client-side paging, every page crawlable. */
  return paginate(posts, { pageSize: 12 });
}

const { page } = Astro.props;
const posts = page.data;
const isFirst = page.currentPage === 1;

/* Intrinsic size looked up from the real file. Without width/height the
   card reserves no space until the image decodes, and the blog list jumps. */
const imageSizes: Record<string, number[]> = imageSizeData as any;
const sizeOf = (src?: string) => (src && imageSizes[src]) || undefined;

/* Every post's featuredImage is a render of the product the article is about, so
   the image is described by that product's name rather than by the file. */
const productTitles = new Map(
  (await getCollection('products')).map((entry) => [entry.data.slug, entry.data.title])
);
const imageAlt = (post: (typeof posts)[number]) =>
  productTitles.get(post.relatedProducts[0] ?? '') ?? '';

const heading = isFirst
  ? 'Product-supporting articles for buyers, EPC teams, and distributors.'
  : `Energy storage guides — page ${page.currentPage}`;
const title = isFirst
  ? 'Energy Storage Guides | Ruibit Power'
  : `Energy Storage Guides — Page ${page.currentPage} | Ruibit Power`;
const description = isFirst
  ? 'Sizing guides and technical explainers on battery storage: kW vs kWh, storage duration, AC vs DC coupling, BMS protection, and C&I BESS selection.'
  : `Page ${page.currentPage} of the Ruibit Power storage guide library: technical explainers on sizing, protection design, and platform selection.`;
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbLabel={isFirst ? 'Energy storage guides' : `Energy storage guides — page ${page.currentPage}`}
>
  <section class:list={['page-hero', { 'page-hero-slim': !isFirst }]}>
    <p class="eyebrow">Blog</p>
    <h1>{heading}</h1>
    {isFirst ? (
      <p>
        Short technical explainers covering the questions that come up before a storage project
        is specified: power versus energy, storage duration, coupling architecture, protection
        design, and platform selection.
      </p>
    ) : (
      <p>
        {page.total} articles in this library, newest first. <a href="/blog/">Back to the
        first page</a>.
      </p>
    )}
  </section>

  <section class="section article-grid">
    {posts.map((post: any) => (
      <article class="article-card">
        {post.featuredImage && (
          <img
            src={post.featuredImage}
            alt={imageAlt(post)}
            width={sizeOf(post.featuredImage)?.[0]}
            height={sizeOf(post.featuredImage)?.[1]}
            loading="lazy"
            decoding="async"
          />
        )}
        <div class="article-card-body">
          <p class="eyebrow">{post.category}</p>
          <h2><a href={`/blog/${post.slug}/`}>{post.title}</a></h2>
          <p class="article-card-excerpt">{post.excerpt}</p>
          <a class="text-link" href={`/blog/${post.slug}/`}>Read article</a>
        </div>
      </article>
    ))}
  </section>

  <Pagination current={page.currentPage} last={page.lastPage} total={page.total} from={page.start + 1} to={page.end + 1} />
</BaseLayout>

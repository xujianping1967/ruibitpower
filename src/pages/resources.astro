---
import imageSizeData from '../data/image-sizes.json';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

/* Intrinsic size looked up from the real file. Without width/height the
   card reserves no space until the image decodes, and the blog list jumps. */
const imageSizes: Record<string, number[]> = imageSizeData as any;
const sizeOf = (src?: string) => (src && imageSizes[src]) || undefined;
const posts = (await getCollection('blog'))
  .map((entry) => ({ ...entry.data, slug: entry.id }))
  .sort((a, b) => b.publishDate.getTime() - a.publishDate.getTime())
  .slice(0, 6);

/* Every post's featuredImage is a render of the product the article is about, so
   the image is described by that product's name rather than by the file. */
const productTitles = new Map((await getCollection('products')).map((entry) => [entry.data.slug, entry.data.title]));
const imageAlt = (post: (typeof posts)[number]) => productTitles.get(post.relatedProducts[0] ?? '') ?? '';
---
<BaseLayout title="Resources | Ruibit Power" description="Energy storage resources, blog articles, product guidance, and project planning references.">
  <section class="page-hero">
    <p class="eyebrow">Resources</p>
    <h1>Useful entry points for battery storage buyers and project teams.</h1>
    <p>Use this page to route visitors into product education, technical explanations, and project consultation.</p>
  </section>
  <section class="section article-grid">
    {posts.map((post) => (
      <article class="article-card">
        {post.featuredImage && (
          <img src={post.featuredImage} alt={imageAlt(post)} width={sizeOf(post.featuredImage)?.[0]} height={sizeOf(post.featuredImage)?.[1]} loading="lazy" decoding="async" />
        )}
        <div class="article-card-body">
          <p class="eyebrow">{post.category}</p>
          <h2><a href={`/blog/${post.slug}/`}>{post.title}</a></h2>
          <p class="article-card-excerpt">{post.excerpt}</p>
          <a class="text-link" href={`/blog/${post.slug}/`}>Read article</a>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>

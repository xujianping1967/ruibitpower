---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery.astro';
import SpecTable from '../../components/SpecTable.astro';
import InquiryBand from '../../components/InquiryBand.astro';
import trust from '../../data/trust.json';
import site from '../../data/site.json';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { product: entry.data },
  }));
}

const { product } = Astro.props;

/* Hyphens are break opportunities, so the browser splits model codes such as
   HZEB-HCT-125TS/265 into two lines that read as two products, and leaves a
   dangling hyphen on compounds like "PV-Storage-". Every hyphenated token is
   therefore wrapped so it stays on one line. The heading text itself is
   unchanged; only the break behaviour differs. The longest token here is
   18 characters, which still fits the 320px column of a 360px phone (284px). */
const escapeHtml = (value: string) =>
  value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const headingHtml = product.title
  .split(' ')
  .map((word) =>
    /[-/]/.test(word)
      ? `<span class="nowrap">${escapeHtml(word)}</span>`
      : escapeHtml(word)
  )
  .join(' ');

/* SEO title: drop the brand suffix (SERP truncation) and add numeric key specs
   only when the platform name carries no figures and the result still fits
   inside the ~60 character SERP display limit. */
const rawTitle = product.seo?.title ?? product.title;
const baseTitle = rawTitle.replace(/\s*\|\s*Ruibit Power\s*$/, '').trim();
const numericSpecs = product.metrics
  .filter((metric) => /\d/.test(metric.value))
  .slice(0, 2)
  .map((metric) => metric.value);
const titledWithSpecs = numericSpecs.length
  ? `${baseTitle} — ${numericSpecs.join(' · ')}`
  : baseTitle;
const pageTitle =
  !/\d/.test(baseTitle) && titledWithSpecs.length <= 62 ? titledWithSpecs : baseTitle;

const pageDescription = product.seo?.description ?? product.summary;

const productSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.title,
  sku: product.slug,
  description: product.summary,
  image: product.gallery.map((image) => new URL(image, site.domain).toString()),
  brand: { '@type': 'Brand', name: site.brand },
  manufacturer: { '@type': 'Organization', name: site.manufacturingPartner },
  category: product.category,
  additionalProperty: product.specs.map((spec) => ({
    '@type': 'PropertyValue',
    name: spec.label,
    value: spec.value,
  })),
  isRelatedTo: product.applications.map((application) => ({
    '@type': 'DefinedTerm',
    name: application,
  })),
};

const faqSchema = product.faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: product.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    }
  : null;

const datasheetHref = `/contact/?application=product-datasheet&product=${encodeURIComponent(product.title)}`;

/* Platforms that ship a real PDF use the download list for it; the rest keep
   routing the request through the inquiry form, so a "Request datasheet" link
   never sits next to a file that does not exist. */
const datasheetFile = product.downloads.find((item) => item.url.toLowerCase().endsWith('.pdf'));
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={product.heroImage}
  structuredData={faqSchema ? [productSchema, faqSchema] : productSchema}
  breadcrumbLabel={product.title}
>
  <section class="product-hero">
    <div>
      <p class="eyebrow">{product.category}</p>
      <h1 set:html={headingHtml} />
      <p>{product.summary}</p>
      <div class="hero-actions">
        <a class="button primary" href="/contact/">Request quotation</a>
        {datasheetFile ? (
          <a class="button secondary" href={datasheetFile.url} download>Download datasheet (PDF)</a>
        ) : (
          <a class="button secondary" href={datasheetHref}>Request datasheet</a>
        )}
      </div>
    </div>
    <img
      src={product.heroImage}
      alt={product.title}
      width="1200"
      height="900"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </section>

  {product.metrics.length > 0 && (
    <section class="metric-strip">
      {product.metrics.map((metric) => (
        <div>
          <strong>{metric.value}</strong>
          <span>{metric.label}</span>
        </div>
      ))}
    </section>
  )}

  <Gallery title={product.title} images={product.gallery} />
  <SpecTable specs={product.specs} />

  {product.applications.length > 0 && (
    <section class="section">
      <div class="section-header">
        <div>
          <p class="eyebrow">Applications</p>
          <h2>Suitable project scenarios</h2>
        </div>
      </div>
      <div class="tag-list">
        {product.applications.map((item) => <span>{item}</span>)}
      </div>
    </section>
  )}

  <section class="section section-soft">
    <div class="section-header">
      <div>
        <p class="eyebrow">Documentation</p>
        <h2>Documents supplied with this platform</h2>
        <p class="section-lead">
          {datasheetFile
            ? 'The platform datasheet is available as a PDF. The certificate package, wiring diagram, and warranty card are issued against the confirmed order configuration.'
            : 'Datasheet, certificate package, wiring diagram, and warranty card are issued against the confirmed order configuration.'}
        </p>
      </div>
    </div>
    <ul class="doc-list">
      <li>
        <h3>Datasheet</h3>
        <p>Full electrical and mechanical parameters for the selected model and variant.</p>
        {datasheetFile ? (
          <a class="text-link" href={datasheetFile.url} target="_blank" rel="noopener">
            {datasheetFile.label} — view or save
          </a>
        ) : (
          <a class="text-link" href={datasheetHref}>Request datasheet</a>
        )}
      </li>
      <li>
        <h3>Certificate package</h3>
        <p>
          Matching certificates for the destination market. Standards referenced:
          {trust.dawnice.certifications.slice(0, 6).join(' / ')} and others.
        </p>
        <a class="text-link" href={datasheetHref}>Request certificate package</a>
      </li>
      <li>
        <h3>Wiring and installation</h3>
        <p>Single-line diagram, terminal layout, and installation guidance for the delivered configuration.</p>
        <a class="text-link" href={datasheetHref}>Request documentation</a>
      </li>
      <li>
        <h3>Warranty card</h3>
        <p>Warranty terms for the battery platform and power conversion equipment, stated per model.</p>
        <a class="text-link" href="/contact/">Discuss warranty terms</a>
      </li>
    </ul>
    <p class="section-note">
      Certification applicability depends on model, order configuration, and destination market. The latest matching
      certificate package is confirmed before final quotation.
    </p>
  </section>

  {product.faqs.length > 0 && (
    <section class="section">
      <div class="section-header">
        <div>
          <p class="eyebrow">FAQ</p>
          <h2>Common questions</h2>
        </div>
      </div>
      <div class="faq-list">
        {product.faqs.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>
  )}

  {product.sources.length > 0 && (
    <section class="section">
      <div class="section-header">
        <div>
          <p class="eyebrow">Sources</p>
          <h2>Where these figures come from</h2>
        </div>
      </div>
      <ul class="source-list">
        {product.sources.map((item) => (
          <li>
            <a href={item.url} rel="nofollow noopener" target="_blank">{item.label}</a>
            {item.note && <span>{item.note}</span>}
          </li>
        ))}
      </ul>
    </section>
  )}

  <InquiryBand />
</BaseLayout>

---
import site from '../data/site.json';
---
<section class="cta-band">
  <div>
    <p class="eyebrow">Project support</p>
    <h2>Need a configured battery storage solution?</h2>
    <p>
      Send your application, location, load profile, and target capacity. We will recommend a suitable Ruibit /
      Dawnice system and confirm sizing assumptions with you.
    </p>
    <p class="cta-promise">
      Quotation target: {site.responsePromise} working hours for a complete brief. Datasheet and certificate package
      supplied per configuration.
    </p>
  </div>
  <div class="cta-actions">
    {/* One action only. A second, lighter button beside the primary one split
        the decision at the moment of conversion; WhatsApp stays reachable from
        the footer, the contact page and the mobile contact bar. */}
    <a class="button primary" href="/contact/">Send inquiry</a>
  </div>
</section>

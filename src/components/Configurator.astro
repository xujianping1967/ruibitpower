---
const applications = [
  { value: 'residential', label: 'Residential / home storage' },
  { value: 'commercial', label: 'Commercial & industrial (C&I)' },
  { value: 'industrial', label: 'Industrial / heavy load' },
  { value: 'pvhybrid', label: 'PV hybrid ESS' },
  { value: 'ev', label: 'EV charging storage' },
  { value: 'containerized', label: 'Containerized / utility-scale' },
];
---

<section class="section section-soft" aria-labelledby="sizing-guide">
  <div class="section-header">
    <div>
      <p class="eyebrow">Sizing guide</p>
      <h2 id="sizing-guide">Find the right storage platform for your project</h2>
      <p class="section-lead">
        Enter your project brief. You will get an indicative product family and a pre-filled quotation request
        you can send in one step.
      </p>
    </div>
  </div>

  <div class="cfg-layout">
    <form class="cfg-form" data-configurator novalidate>
      <label>
        <span>Application <em>required</em></span>
        <select name="application" required>
          <option value="">Select an application</option>
          {applications.map((item) => <option value={item.value}>{item.label}</option>)}
        </select>
      </label>

      <div class="cfg-row">
        <label>
          <span>Target power (kW)</span>
          <input type="number" name="power" min="0" step="0.1" placeholder="e.g. 125" />
        </label>
        <label>
          <span>Target energy (kWh)</span>
          <input type="number" name="energy" min="0" step="0.1" placeholder="e.g. 261" />
        </label>
      </div>

      <div class="cfg-row">
        <label>
          <span>Country / region</span>
          <input type="text" name="country" placeholder="e.g. Germany" />
        </label>
        <label>
          <span>Backup duration (hours)</span>
          <input type="number" name="backup" min="0" step="0.5" placeholder="e.g. 4" />
        </label>
      </div>

      <label>
        <span>Existing or planned PV capacity (kWp) <em>optional</em></span>
        <input type="number" name="pv" min="0" step="0.1" placeholder="e.g. 200" />
      </label>

      <button class="button primary" type="submit">Show recommended system</button>
    </form>

    <div class="cfg-result" data-configurator-result hidden aria-live="polite"></div>
  </div>
</section>

<script src="/assets/js/configurator.js" is:inline></script>
